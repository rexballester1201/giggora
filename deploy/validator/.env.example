# Giggora validator host configuration.
# Copy to .env on EACH validator host and set the values for that host.

BESU_IMAGE=hyperledger/besu:26.8.1

# This host's address as OTHER VALIDATORS must dial it. A private/VPN address is
# preferred; validators should not be reachable over the public internet at all.
# Besu rejects a DNS name here — it must be an IP literal.
P2P_ADVERTISED_HOST=10.0.0.11

P2P_PORT=30303
MIN_GAS_PRICE=1000000000

# enode of validator-1, using an IP literal (a hostname is rejected).
BOOTNODE_ENODE=enode://<128-hex-pubkey>@10.0.0.11:30303
