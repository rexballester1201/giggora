# Giggora block explorer.
#
# One hostname serves both the UI and the API: the browser calls /api/* on the
# same origin it loaded from, so there is no CORS preflight on every request and
# no second certificate to renew.
#
# Like the RPC endpoint, this gets hybrid post-quantum TLS for free — Caddy is
# Go, and Go 1.24+ negotiates X25519MLKEM768 by default. That protects the
# transport. It says nothing about the chain's signatures, which are secp256k1
# and not post-quantum (docs/architecture.md §14).

{
	email {$ACME_EMAIL}
	# Test here first to avoid burning Let's Encrypt rate limits on a typo:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$PUBLIC_HOSTNAME} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# API. Rate limiting is done by the explorer API itself (RATE_LIMIT_MAX /
	# RATE_LIMIT_WINDOW, keyed per client IP via TRUSTED_PROXY_CIDR), NOT here.
	#
	# An earlier version had a `rate_limit { ... }` block at this point. That
	# directive is not part of Caddy — it is the third-party plugin
	# github.com/mholt/caddy-ratelimit, which the stock caddy:2-alpine image does
	# not include. Caddy refused to start with "unrecognized directive:
	# rate_limit" and the entire explorer was unreachable. If an edge limiter is
	# wanted later, build a custom image with xcaddy and re-add it; do not paste
	# the directive back against the stock image.
	handle /api/* {
		reverse_proxy api:4000 {
			# The API reads this to attribute requests to real clients rather
			# than to Caddy. It only trusts it from TRUSTED_PROXY_CIDR.
			header_up X-Real-IP {remote_host}
		}
	}

	handle /health {
		respond "ok" 200
	}

	# Everything else is the Next.js app.
	handle {
		reverse_proxy web:3000
	}
}
