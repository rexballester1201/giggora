# Giggora explorer host configuration.
# Copy to .env and fill in. NEVER commit the filled-in .env (brief §30).

# --- Postgres -----------------------------------------------------------------
# This database is never published to a host port. The password still matters:
# anything else on the explorer host's docker network can reach it.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=giggora
POSTGRES_USER=giggora
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32

# --- Chain --------------------------------------------------------------------
# The RPC node, reached over the private network. Do NOT point the indexer at
# the public HTTPS endpoint — it would rate-limit itself through its own Caddy.
RPC_URL=http://10.0.0.20:8545
CHAIN_ID=4041
CHAIN_NAME=Giggora
CURRENCY_NAME=Giggora
CURRENCY_SYMBOL=GIG
CURRENCY_DECIMALS=18

# --- API ----------------------------------------------------------------------
API_POOL_SIZE=10
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=60000
LOG_LEVEL=info

# Caddy's address on the compose network, in CIDR form. Get it with:
#   docker network inspect giggora-explorer_default
# Leave it UNSET and every request appears to come from Caddy, collapsing the
# rate limiter into one global bucket. Set it to `true` and the limiter trusts a
# client-supplied header, which makes it decorative. Neither is what you want.
TRUSTED_PROXY_CIDR=172.18.0.0/16

# --- Web (BUILD-TIME) ---------------------------------------------------------
# NEXT_PUBLIC_* are inlined into the client bundle when the image is BUILT, not
# read when it runs. Change any of these and you must rebuild the web image:
#   docker compose build web
NEXT_PUBLIC_API_BASE=https://explorer.giggora.example/api/v1
NEXT_PUBLIC_RPC_URL=https://rpc.giggora.example
NEXT_PUBLIC_EXPLORER_URL=https://explorer.giggora.example
NEXT_PUBLIC_NETWORK_LABEL=Giggora Mainnet

# --- TLS ----------------------------------------------------------------------
PUBLIC_HOSTNAME=explorer.giggora.example
ACME_EMAIL=ops@giggora.example
