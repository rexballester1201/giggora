# Giggora faucet — environment.
#
# The faucet reads the REPOSITORY ROOT .env (chain id, RPC URL, DATABASE_URL),
# so on the devnet none of this is needed. These are the production knobs.
#
# Copy to the root .env, or set them in the environment. NEVER commit a filled-in
# copy: this file is the one place in the project where a real private key lives.

# --- signing key -------------------------------------------------------------
# The account the faucet pays FROM. Unset, the faucet uses the PUBLISHED Anvil #1
# key and refuses to start on any chain but the devnet (4043) — a published key
# on a real chain belongs to whoever asks for it first.
#
# Generate one that has never touched a shared machine:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# This is a HOT key on an internet-facing service. Fund it with a working float
# (a few thousand GIG) and top it up; never park the whole pool behind it.
FAUCET_PRIVATE_KEY=

# --- privacy -----------------------------------------------------------------
# Salt for the per-source rate limit. Client IPs are hashed with this and never
# stored (see database/migrations/006_faucet.sql). Changing it resets every
# per-source cooldown. Any long random string.
FAUCET_IP_SALT=

# --- proof of work -----------------------------------------------------------
# Optional. Unset, a random secret is generated per process, so a restart
# invalidates outstanding challenges — fine for one instance, but set it
# explicitly if you run more than one so they accept each other's challenges.
FAUCET_POW_SECRET=

# --- server ------------------------------------------------------------------
FAUCET_PORT=4200
# Loopback by default. Put Caddy in front for anything public, and set
# TRUSTED_PROXY_CIDR (root .env) to Caddy's address — unset, every request looks
# like it came from the proxy and the per-source cooldown becomes one global
# bucket; set to `true`, it trusts a client header and becomes decorative.
FAUCET_HOST=127.0.0.1

# Where "View the transaction" links point.
FAUCET_EXPLORER_URL=http://localhost:3000

# Coarse outer bound before the cooldowns and proof of work apply.
FAUCET_RATE_LIMIT_MAX=30
FAUCET_RATE_LIMIT_WINDOW=1 minute

# Postgres pool size for the faucet process. It serialises on one row, so this
# never needs to be large.
FAUCET_POOL_SIZE=5
