# Giggora — example environment.
#
# The real .env is GENERATED. Do not copy this file to .env by hand; run:
#
#     bash scripts/create-genesis.sh
#
# which derives .env from blockchain/config/chain.config.json and fills in
# BOOTNODE_ENODE from the generated validator keys.
#
# This file exists to document the variables and to satisfy brief §30
# ("create .env.example instead" of committing secrets).
#
# NOTHING SECRET BELONGS IN .env. Validator private keys live in
# blockchain/nodes/*/key, which is gitignored and never baked into an image.

COMPOSE_PROJECT_NAME=giggora
BESU_IMAGE=hyperledger/besu:26.8.1

# --- chain identity ---
CHAIN_NAME=Giggora
CHAIN_NETWORK=devnet
CHAIN_ID=4043
NETWORK_ID=4043
CURRENCY_NAME=Giggora
CURRENCY_SYMBOL=GIG
CURRENCY_DECIMALS=18

# --- consensus ---
VALIDATOR_COUNT=4
BLOCK_PERIOD_SECONDS=2
MIN_GAS_PRICE=1000000000

# --- ports ---
RPC_HTTP_PORT=8545
RPC_WS_PORT=8546
P2P_PORT=30303

# --- endpoints ---
RPC_URL=http://localhost:8545
WS_URL=ws://localhost:8546

# --- p2p bootstrap ---
# Generated by scripts/create-genesis.sh from validator-1's public key.
BOOTNODE_ENODE=enode://<128-hex-public-key>@giggora-validator-1:30303
