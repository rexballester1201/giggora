{
  "name": "giggora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Giggora — an independent, EVM-compatible Layer-1 blockchain and block explorer.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "genesis": "bash scripts/create-genesis.sh",
    "start": "bash scripts/start-network.sh",
    "stop": "docker compose down",
    "restart": "docker compose down && bash scripts/start-network.sh",
    "logs": "docker compose logs -f",
    "verify": "node scripts/verify-network.mjs",
    "clean": "docker compose down -v && rm -rf blockchain/nodes blockchain/genesis/networkFiles blockchain/genesis/genesis.json",
    "config": "node scripts/gen-config.mjs",
    "setup:contracts": "bash scripts/setup-contracts.sh",
    "contracts:build": "bash scripts/forge.sh build",
    "contracts:test": "bash scripts/forge.sh test",
    "contracts:deploy": "node scripts/deploy-contracts.mjs",
    "verify:all": "node scripts/verify-network.mjs && bash scripts/forge.sh test && node scripts/deploy-contracts.mjs",
    "db:migrate": "bash scripts/db-migrate.sh",
    "indexer": "node indexer/src/index.ts",
    "indexer:once": "node indexer/src/index.ts --once",
    "indexer:status": "node indexer/src/index.ts --status",
    "indexer:verify": "node scripts/verify-indexer.ts",
    "indexer:recovery-test": "node scripts/test-indexer-recovery.ts",
    "blockscout:up": "docker compose -f docker-compose.yml -f docker-compose.blockscout.yml up -d blockscout",
    "blockscout:down": "docker compose -f docker-compose.yml -f docker-compose.blockscout.yml stop blockscout",
    "crosscheck": "node scripts/crosscheck-blockscout.ts",
    "load": "node scripts/load-generator.mjs",
    "api": "node explorer-api/src/server.ts",
    "api:test": "node scripts/test-api.ts",
    "indexer:tokens": "node indexer/src/index.ts --tokens",
    "web:install": "npm --prefix explorer-web install",
    "web:build": "npm --prefix explorer-web run build",
    "web:dev": "npm --prefix explorer-web run dev",
    "web:start": "npm --prefix explorer-web run start",
    "web:test": "node scripts/test-explorer-web.mjs",
    "api:regressions": "node scripts/test-api-regressions.ts",
    "test:all": "node scripts/verify-network.mjs && node scripts/verify-indexer.ts && node scripts/test-api.ts && node scripts/test-api-regressions.ts && node scripts/test-explorer-web.mjs && node scripts/test-wallet.mjs",
    "dapp": "node dapp/serve.mjs",
    "wallet:test": "node scripts/test-wallet.mjs",
    "monitor": "node scripts/monitor-chain.mjs",
    "monitor:watch": "node scripts/monitor-chain.mjs --watch 30",
    "backup": "bash scripts/backup.sh",
    "transition": "node scripts/schedule-transition.mjs",
    "transition:test": "node scripts/test-qbft-transition.mjs",
    "stack": "docker compose --profile explorer up -d --build",
    "stack:down": "docker compose --profile explorer down",
    "stack:logs": "docker compose --profile explorer logs -f indexer api web"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.12.3",
    "pg": "^8.23.0",
    "viem": "2.56.3"
  }
}
